# Cloudflare Pages response headers (this file is read by Cloudflare, not served). See HOSTING.md.
# Game files have a content hash in their name: they never change, so browsers may keep them for a year.
/game/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# The page and the manifest point at the current game files: always check for a newer version.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
